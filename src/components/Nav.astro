---
import settings from '../data/settings.json';
const links = [
  { href: '/', label: '홈' },
  { href: '/about', label: '소개' },
  { href: '/beliefs', label: '신앙고백' },
  { href: '/worship', label: '예배' },
  { href: '/sermons', label: '설교' },
  { href: '/news', label: '소식' },
  { href: '/resources', label: '자료' },
  { href: '/visit', label: '오시는 길' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/"><span class="banner"></span>{settings.churchName} <small>{settings.tagline}</small></a>
    <button class="menu-toggle" aria-label="메뉴" aria-expanded="false" data-toggle>☰</button>
    <nav aria-label="주요 메뉴" data-menu>
      <ul class="list-reset nav">
        {links.map((l) => {
          const active = l.href === '/' ? path === '/' : path.startsWith(l.href);
          return <li><a href={l.href} aria-current={active ? 'page' : undefined}>{l.label}</a></li>;
        })}
      </ul>
    </nav>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: var(--paper); border-bottom: 1px solid var(--line); box-shadow: 0 1px 0 rgba(23,35,61,.04); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 1.5rem; }
  .brand { font-family: var(--serif); font-weight: 700; font-size: 1.2rem; color: var(--ink); display: inline-flex; align-items: center; gap: .6rem; }
  .brand:hover { text-decoration: none; }
  .brand .banner { width: 6px; height: 1.3rem; background: var(--ink); display: inline-block; border-radius: 1px; }
  .brand small { font-family: var(--sans); font-weight: 400; font-size: .7rem; color: var(--muted); }
  .nav { display: flex; flex-wrap: wrap; gap: .15rem .3rem; }
  .nav a { color: var(--muted); font-size: .95rem; padding: .4rem .8rem; border-radius: 999px; }
  .nav a:hover { color: var(--ink); background: rgba(23,35,61,.06); text-decoration: none; }
  .nav a[aria-current="page"] { color: #fff; background: var(--ink); }
  .menu-toggle { display: none; background: none; border: 1px solid var(--line); border-radius: 6px; padding: .4rem .7rem; cursor: pointer; font-size: 1.1rem; }
  @media (max-width: 820px) {
    .menu-toggle { display: inline-flex; }
    [data-menu] { position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 1px solid var(--line); max-height: 0; overflow: hidden; transition: max-height .25s; }
    [data-menu].open { max-height: 70vh; }
    .nav { flex-direction: column; padding: .5rem 1.5rem 1rem; }
    .nav a { display: block; }
  }
</style>
<script>
  const t = document.querySelector('[data-toggle]');
  const m = document.querySelector('[data-menu]');
  t?.addEventListener('click', () => {
    const open = m?.classList.toggle('open');
    t.setAttribute('aria-expanded', String(!!open));
  });
</script>
