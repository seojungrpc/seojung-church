---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Gallery from '../components/Gallery.astro';
import RpHistory from '../components/RpHistory.astro';
import { pageImages } from '../utils/images';
import { resourceGroups } from '../data/resources';
const { hero, gallery } = pageImages('resources');
---
<BaseLayout title="개혁장로교회 · 자료">
  <PageHero image={hero} alt="개혁장로교회" />

  <section class="section">
    <div class="container prose">
      <p class="eyebrow">개혁장로교회</p>
      <h1>개혁장로교회의 역사와 신앙</h1>
      <RpHistory intro={true} />
      <p class="more-wrap"><a class="btn btn--gold" href="/rp-history">더보기 →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">참고 자료</p>
      <h2>RP 계열 참고 사이트</h2>
      <p class="lede">개혁장로교회와 관련된 교단·신학교·예배 자료 링크입니다.</p>
      <div class="res">
        {resourceGroups.map((g) => (
          <section class="res-group">
            <h3>{g.title}</h3>
            {g.note && <p class="meta">{g.note}</p>}
            {g.links.length > 0 && (
              <ul class="list-reset">
                {g.links.map((l) => (
                  <li class="res-item"><a href={l.url} target="_blank" rel="noopener">{l.name}</a>{l.desc && <span class="rd">{l.desc}</span>}</li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>

  <Gallery images={gallery} />
</BaseLayout>
<style>
  .more-wrap { margin-top: 1.6rem; }
  /* 3열 배치. 각 묶음은 열을 넘어 쪼개지지 않음(break-inside: avoid) */
  .res {
    column-count: 3;
    column-gap: 2.4rem;
    margin-top: 1.8rem;
  }
  .res-group {
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    page-break-inside: avoid;
    margin-bottom: 2rem;
  }
  .res-group h3 { font-family: var(--serif); padding-bottom: .5rem; border-bottom: 2px solid var(--gold); margin-bottom: .6rem; }
  .res-item { padding: .38rem 0; }
  .res-item a { font-weight: 500; }
  .rd { display: block; color: var(--muted); font-size: .82rem; margin-top: .1rem; }
  @media (max-width: 860px) { .res { column-count: 2; } }
  @media (max-width: 560px) { .res { column-count: 1; } }
</style>
