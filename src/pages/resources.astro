---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Gallery from '../components/Gallery.astro';
import RpHistory from '../components/RpHistory.astro';
import { pageImages } from '../utils/images';
import { resourceGroups, books } from '../data/resources';
const { hero, gallery } = pageImages('resources');
---
<BaseLayout title="개혁장로교회 · 자료">
  <PageHero image={hero} alt="개혁장로교회" />

  <section class="section">
    <div class="container prose">
      <p class="eyebrow">개혁장로교회</p>
      <h1>개혁장로교회의 역사와 신앙</h1>
      <RpHistory intro={true} />
      <p class="more-wrap"><a class="btn btn--gold" href="/rp-history">더보기 →</a></p>
    </div>
  </section>

  {resourceGroups.map((g) => (
    <section class="section">
      <div class="container">
        <p class="eyebrow">교단</p>
        <h2>{g.title}</h2>
        <ul class="denoms list-reset">
          {g.links.map((l) => (
            <li class="denom"><a href={l.url} target="_blank" rel="noopener">{l.name}</a></li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="container">
      <p class="eyebrow">참고 서적</p>
      <h2>참고 서적</h2>
      <ul class="books list-reset">
        {books.map((b) => <li class="book" set:html={b} />)}
      </ul>
    </div>
  </section>

  <Gallery images={gallery} />
</BaseLayout>
<style>
  .more-wrap { margin-top: 1.6rem; }

  /* 교단 홈페이지 — 링크가 폭을 고르게 채우도록 */
  .denoms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: .3rem 2rem;
    margin-top: 1.1rem;
  }
  .denom { padding: .45rem 0; }
  .denom a { font-weight: 500; }

  /* 참고 서적 — 서지 목록 */
  .books { max-width: 54rem; margin-top: 1.1rem; }
  .book {
    font-family: var(--serif);
    color: var(--ink-soft);
    line-height: 1.65;
    padding: .6rem 0 .6rem 1.4rem;
    text-indent: -1.4rem;
    border-top: 1px solid var(--line);
  }
  .book:first-child { border-top: 0; }
  .book :global(em) { font-style: italic; }
</style>
